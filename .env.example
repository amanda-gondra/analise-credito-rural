# Copy this file to .env and fill in the values. Never commit the .env file.

# Local PostgreSQL (docker-compose.yml and the pipeline)
POSTGRES_DB=rural_credit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Application roles created by sql/roles.sql. The pipeline connects as loader.
# Replace both values with random passwords of at least 16 characters (roles.sql rejects shorter ones).
LOADER_PASSWORD=change-me-too
API_READER_PASSWORD=change-me-as-well

# API (api/app/config.py). Origins allowed by CORS, comma-separated; empty = none ("*" is refused).
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
# Header the host's proxy writes with the visitor's address (CF-Connecting-IP on Render).
# Empty locally: the visitor is the address of the connection. X-Forwarded-For is refused (D31).
CLIENT_IP_HEADER=

# Assistant (decision D18). Free keys, each created on the provider's own site.
# A provider with an empty key is skipped; with no key at all the assistant answers 503
# and the rest of the API keeps working.
ASSISTANT_PROVIDERS=gemini,groq,cloudflare
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ASSISTANT_PER_MINUTE=5
ASSISTANT_PER_DAY=30
ASSISTANT_GLOBAL_PER_DAY=300

# Production only (Neon). These live in .env.production, written by scripts/setup_remote_database.py
# (README, "Publicação"); set them in a terminal only to load or test the published database.
# When set, the pipeline uses DATABASE_URL instead of the POSTGRES_* values.
# DATABASE_URL_READER is the same for the read-only role, used by the API and the query tests.
# DATABASE_URL_READER=postgresql+psycopg://api_reader:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
